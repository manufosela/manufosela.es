---
import { trajectoryData } from '~/data/trajectory';

interface Props {
  language: 'es' | 'en';
}

const { language } = Astro.props;
const d = trajectoryData[language];
---

<div class="trajectory-page">

  <!-- Hero -->
  <section class="traj-hero">
    <span class="u-label">{d.badge}</span>
    <h1 class="traj-hero__title">{d.title}</h1>
    <div class="traj-hero__bar" aria-hidden="true"></div>
  </section>

  <!-- Timeline + photo aside -->
  <section class="traj-body" aria-label={d.resumeTitle}>
    <div class="timeline">
      <h2 class="timeline__heading">{d.resumeTitle}</h2>
      <div class="timeline__list">
        <div class="timeline__line" aria-hidden="true"></div>
        {d.timeline.map((item) => (
          <div class="timeline__item">
            <div class:list={['timeline__dot', { 'timeline__dot--current': item.current }]}></div>
            <div class="timeline__content">
              <span class="timeline__scope">{item.scope}</span>
              <h3 class="timeline__title">{item.title}</h3>
              <p class="timeline__desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <figure class="traj-photo">
      <img
        src="/images/about1280.webp"
        srcset="/images/about320.webp 320w, /images/about480.webp 480w, /images/about768.webp 768w, /images/about1280.webp 1280w"
        sizes="(min-width: 1024px) 38vw, 100vw"
        alt={d.photoAlt}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </section>

</div>

<style>
  .trajectory-page {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 8vh, 5rem);
    padding-block: clamp(2rem, 6vh, 4rem);
  }

  .trajectory-page > section {
    padding-inline: clamp(1.5rem, 4vw, 3rem);
    max-width: 1280px;
    margin-inline: auto;
    width: 100%;
  }

  /* Hero */
  .traj-hero__title {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.03em;
    color: var(--on-surface);
    margin-top: 0.5rem;
  }
  .traj-hero__bar {
    width: 3rem;
    height: 3px;
    background-color: var(--primary-container);
    margin-top: 1rem;
  }

  /* Body: timeline + photo */
  .traj-body {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vh, 4rem);
  }

  /* Timeline */
  .timeline__heading {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(1.5rem, 3vw, 1.75rem);
    font-weight: 800;
    color: var(--on-surface);
    margin-bottom: clamp(2rem, 5vh, 3rem);
  }
  .timeline__list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .timeline__line {
    position: absolute;
    left: 7px;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background-color: color-mix(in srgb, var(--outline-variant) 30%, transparent);
  }
  .timeline__item {
    position: relative;
    padding-left: 2.5rem;
  }
  .timeline__dot {
    position: absolute;
    left: 0;
    top: 0.375rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 2px solid var(--primary-container);
    background-color: var(--surface);
  }
  .timeline__dot--current {
    box-shadow: 0 0 10px color-mix(in srgb, var(--primary-container) 30%, transparent);
  }
  .timeline__scope {
    font-family: 'Inter', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--primary-fixed-dim);
    display: block;
    margin-bottom: 0.5rem;
  }
  .timeline__title {
    font-family: 'Manrope', sans-serif;
    font-size: clamp(1rem, 2vw, 1.125rem);
    font-weight: 700;
    color: var(--on-surface);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }
  .timeline__desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--on-surface-variant);
    font-weight: 300;
  }

  /* Photo aside: sin pie ni detalle, acompaña al timeline */
  .traj-photo {
    margin: 0;
  }
  .traj-photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.75rem;
  }

  @media (min-width: 1024px) {
    .traj-body {
      display: grid;
      grid-template-columns: 58fr 42fr;
      gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }
    .traj-photo {
      position: sticky;
      top: 6rem;
      margin-top: calc(clamp(1.5rem, 3vw, 1.75rem) * 1.3 + clamp(2rem, 5vh, 3rem));
    }
  }
</style>
